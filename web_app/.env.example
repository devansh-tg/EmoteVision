# EmoteVision environment reference
# Copy this file to .env inside web_app/ when local overrides are needed.

# Server
EMOTEVISION_HOST=0.0.0.0
EMOTEVISION_PORT=5000
EMOTEVISION_DEBUG=false
EMOTEVISION_SECRET_KEY=change-this-before-production
EMOTEVISION_CORS_ORIGINS=*

# Model artifacts, relative to web_app/
EMOTEVISION_MODEL=../models/custom_cnn/model.h5
EMOTEVISION_TFLITE=../models/custom_cnn/model.tflite
EMOTEVISION_META=../models/custom_cnn/model_meta.json

# Inference backend: auto, true, or false
EMOTEVISION_USE_TFLITE=auto

# Camera
EMOTEVISION_CAMERA=0
EMOTEVISION_CAMERA_WIDTH=640
EMOTEVISION_CAMERA_HEIGHT=480
EMOTEVISION_GUI_CAMERA_WIDTH=1280
EMOTEVISION_GUI_CAMERA_HEIGHT=720

# Inference tuning
EMOTEVISION_SMOOTHING=0.4
EMOTEVISION_SCALE_FACTOR=1.3
EMOTEVISION_MIN_NEIGHBORS=5
